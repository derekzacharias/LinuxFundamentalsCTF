#!/usr/bin/env bash
set -euo pipefail

# ctf — main game CLI for the Linux Fundamentals CTF.
# Usage: ctf [start|list|open <n>|next|hint <n> [lvl]|submit <n> FLAG|status|score|map|reset [<n>|all]|help]

BIN_DIR="/usr/local/bin"
LESSON_DIR="/opt/lessons"
STATE_DIR="${CTF_STATE_DIR:-$HOME/.ctf_state}"
PROGRESS_FILE="$STATE_DIR/progress"
SCORE_FILE="$STATE_DIR/score"
HINT_FILE="$STATE_DIR/hints"
ATTEMPT_FILE="$STATE_DIR/attempts"
LAST_LESSON=24

# ---- colors (only when stdout is a TTY) ----
if [[ -t 1 ]]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; CYAN=$'\033[36m'; YELLOW=$'\033[33m'; GREEN=$'\033[32m'; RED=$'\033[31m'; RESET=$'\033[0m'
else
  BOLD=""; DIM=""; CYAN=""; YELLOW=""; GREEN=""; RED=""; RESET=""
fi

die() { echo -e "${RED}error:${RESET} $*" >&2; exit 1; }
info() { echo -e "${CYAN}[*]${RESET} $*"; }

mkdir -p "$STATE_DIR" 2>/dev/null || true

# ---- state helpers ----
completed() { # completed <n> -> 0/1
  grep -qx "lesson$1" "$PROGRESS_FILE" 2>/dev/null
}
score_get() { cat "$SCORE_FILE" 2>/dev/null || echo 0; }
MAX_SCORE=$(( 24 * 100 ))
score_add() { # score_add <delta>
  local cur new
  cur=$(score_get)
  new=$(( cur + $1 ))
  [[ $new -lt 0 ]] && new=0
  [[ $new -gt $MAX_SCORE ]] && new=$MAX_SCORE
  echo "$new" > "$SCORE_FILE"
}
mark_hint() { echo "lesson$1:$2" >> "$HINT_FILE"; }

rank_title() { # rank_title <xp>
  local xp=$1
  if   (( xp >= 2200 )); then echo "Linux Master"
  elif (( xp >= 2000 )); then echo "Terminal Legend"
  elif (( xp >= 1500 )); then echo "Shell Hacker"
  elif (( xp >= 900 ));  then echo "Linux Operative"
  elif (( xp >= 400 ));  then echo "Command-line Adept"
  elif (( xp >= 100 ));  then echo "Terminal Rookie"
  else echo "Shell Novice"; fi
}

# ---- views ----
usage() {
  cat <<'EOS'
Linux Fundamentals CTF — command-line game

  ctf start             Open lesson 1
  ctf list              List all lessons with completion status
  ctf open <n>          Display lesson n (LEARN + TASK)
  ctf brief <n>         Quick task card for lesson n (no spoilers)
  ctf next              Open the next unfinished lesson
  ctf hint <n> [1-3]    Get a hint (1 free, 2 = -10 XP, 3 = -20 XP)
  ctf submit <n> FLAG   Submit a flag for lesson n
  ctf status            Progress dashboard
  ctf score             XP, rank, per-lesson breakdown
  ctf map               Curriculum map
  ctf reset [<n>|all]   Reset progress (default: all)
EOS
}

lesson_title() { # lesson_title <n>
  sed -n '1{ s/^Lesson [0-9]*: //p; q }' "$LESSON_DIR/lesson$1.txt" 2>/dev/null || echo "Lesson $1"
}

lesson_mark() { # lesson_mark <n>
  completed "$1" && echo "✓" || echo "·"
}

cmd_list() {
  local i mark title
  printf '%s\n' "${BOLD}Linux Fundamentals CTF — Lessons${RESET}"
  for i in $(seq 1 "$LAST_LESSON"); do
    mark=$(lesson_mark "$i")
    title=$(lesson_title "$i")
    printf '  %s  %2d  %s\n' "$mark" "$i" "$title"
  done
  echo
  echo "Legend: ✓ done · not done   —   Open with: ctf open <n>"
}

cmd_brief() {
  local n=${1:?usage: ctf brief <n>}
  [[ $n =~ ^[0-9]+$ && $n -ge 1 && $n -le $LAST_LESSON ]] || die "lesson must be 1-$LAST_LESSON"
  local f="$LESSON_DIR/lesson${n}_min.txt"
  [[ -f $f ]] || die "no task card for lesson $n"
  cat "$f"
}

cmd_open() {
  local n=${1:?usage: ctf open <n>}
  [[ $n =~ ^[0-9]+$ && $n -ge 1 && $n -le $LAST_LESSON ]] || die "lesson must be 1-$LAST_LESSON"
  local f="$LESSON_DIR/lesson$n.txt"
  [[ -f $f ]] || die "missing $f"
  if [[ -t 0 ]]; then
    less -R "$f" || true
  else
    cat "$f"
  fi
}

cmd_next() {
  local n=1
  while completed "$n" && (( n <= LAST_LESSON )); do n=$((n+1)); done
  if (( n > LAST_LESSON )); then
    echo "All $LAST_LESSON lessons completed — course finished! (rank: $(rank_title "$(score_get)"))"
    return 0
  fi
  echo "Next up: Lesson $n — $(lesson_title "$n")"
  echo "Open with: ctf open $n"
}

cmd_status() {
  local done=0 i xp rank next=1
  for i in $(seq 1 "$LAST_LESSON"); do completed "$i" && done=$((done+1)); done
  xp=$(score_get); rank=$(rank_title "$xp")
  while completed "$next" && (( next <= LAST_LESSON )); do next=$((next+1)); done
  echo " ${BOLD}CTF STATUS${RESET}"
  echo " ─────────────────────────────"
  printf "  Rank:      %s\n" "$rank"
  printf "  XP:        %d / %d\n" "$xp" "$(( LAST_LESSON * 100 ))"
  printf "  Lessons:   %d / %d completed\n" "$done" "$LAST_LESSON"
  if (( next <= LAST_LESSON )); then
    printf "  Next:      lesson %d (%s)\n" "$next" "$(lesson_title "$next")"
    echo "  Open:      ctf open $next"
  else
    echo "  Status:    course complete. Legendary."
  fi
  echo " ─────────────────────────────"
}

cmd_score() {
  local xp rank i mark hintcost
  xp=$(score_get); rank=$(rank_title "$xp")
  echo " ${BOLD}SCORE${RESET}  rank: $rank   total XP: $xp"
  echo " ──────────────────────────────────────"
  for i in $(seq 1 "$LAST_LESSON"); do
    mark=$(lesson_mark "$i")
    hintcost=$(grep -c "^lesson$i:" "$HINT_FILE" 2>/dev/null || true)
    printf "  %s %2d  %-32s" "$mark" "$i" "$(lesson_title "$i")"
    completed "$i" && printf '  100 XP' || printf '  -'
    (( hintcost > 0 )) && printf '  (hints used)'
    echo
  done
}

cmd_hint() {
  local n=${1:?usage: ctf hint <n> [1-3]}
  local lvl=${2:-1}
  [[ $n =~ ^[0-9]+$ && $n -ge 1 && $n -le $LAST_LESSON ]] || die "lesson must be 1-$LAST_LESSON"
  [[ $lvl =~ ^[1-3]$ ]] || die "hint level must be 1-3"
  completed "$n" && { echo "Lesson $n is already completed — no hints needed."; return 0; }
  local f="$LESSON_DIR/lesson${n}_hints.txt"
  [[ -f $f ]] || die "no hints available for lesson $n"
  echo -e "${YELLOW}Hint $lvl for lesson $n:${RESET}"
  awk -v lvl="$lvl" -F'\|' '/^HINT / { c++; if (c <= lvl) print "  " $0 }' "$f"
  case $lvl in
    2) echo -e "${DIM}(using hint level 2 will cost 10 XP when you complete this lesson)${RESET}"; mark_hint "$n" 2 ;;
    3) echo -e "${DIM}(using hint level 3 will cost 20 XP when you complete this lesson)${RESET}"; mark_hint "$n" 3 ;;
  esac
}

cmd_submit() {
  local n=${1:?usage: ctf submit <n> FLAG{...}}
  local flag=${2:?usage: ctf submit <n> FLAG{...}}
  [[ $n =~ ^[0-9]+$ && $n -ge 1 && $n -le $LAST_LESSON ]] || die "lesson must be 1-$LAST_LESSON"
  completed "$n" && { echo "Lesson $n already completed."; return 0; }

  if ! "$BIN_DIR/check_flag" "$n" "$flag"; then
    echo "lesson$n:fail" >> "$ATTEMPT_FILE"
    before=$(score_get)
    score_add -5
    after=$(score_get)
    if (( after < before )); then
      echo -e "${RED}❌ Wrong flag for lesson $n.${RESET} (-5 XP)"
    else
      echo -e "${RED}❌ Wrong flag for lesson $n.${RESET} (no XP to lose yet)"
    fi
    echo -e "Stuck? Try: ${YELLOW}ctf hint $n 1${RESET}"
    return 1
  fi

  echo -e "${GREEN}✅ Correct! Lesson $n flag accepted.${RESET}"
  if ! "$BIN_DIR/validate_lesson" "$n"; then
    echo -e "${RED}❌ Skill checks failed — the lesson is NOT complete yet.${RESET}" >&2
    echo -e "   Review the steps above, fix the missing artifacts, then re-run:"
    echo -e "   ${YELLOW}ctf submit $n <your_flag>${RESET}"
    return 1
  fi
  echo -e "${GREEN}🔎 Skill checks passed.${RESET}"

  echo "lesson$n" >> "$PROGRESS_FILE"
  score_add 100
  # hint penalty: only the deepest hint level used counts
  local penalty=0 maxlvl=0 lvl
  for lvl in $(grep "^lesson$n:" "$HINT_FILE" 2>/dev/null | cut -d: -f2 | sort -u || true); do
    (( lvl > maxlvl )) && maxlvl=$lvl
  done
  case $maxlvl in 2) penalty=10;; 3) penalty=20;; esac
  if (( penalty > 0 )); then
    score_add -$penalty
    echo -e "${DIM}(hint penalty: -$penalty XP)${RESET}"
  fi

  local next=$((n+1))
  if (( next <= LAST_LESSON )); then
    echo "Next: ctf open $next   (or 'ctf next')"
  else
    echo -e "${BOLD}All $LAST_LESSON lessons complete — course finished!${RESET}"
    echo -e "Your rank: $(rank_title "$(score_get)") — see: ctf score"
  fi
}

cmd_map() {
  cat <<'EOS'
 ACT I — FUNDAMENTALS                    ACT II — INTERMEDIATE
  1  Orientation & first flag            13  Archives & compression
  2  Paths & hidden files                14  Symbolic & hard links
  3  File operations                     15  Shell expansion & quoting
  4  Permissions & ownership             16  Job control & signals
  5  Text, redirection, pipes            17  sed & awk
  6  Processes & logs                    18  Regex & grep mastery
  7  Package management                  19  Permissions & ACLs
  8  Users, groups, sudo                 20  systemd
  9  PATH & environment                  21  cron & scheduling
 10  Bash scripting I                    22  SSH & remote access
 11  find & grep                         23  Networking tools
 12  Networking basics                   24  CAPSTONE: the breach
EOS
}

cmd_reset() {
  local target=${1:-all}
  if [[ $target == all ]]; then
    rm -f "$PROGRESS_FILE" "$SCORE_FILE" "$HINT_FILE" "$ATTEMPT_FILE"
    info "All progress reset. Fresh start — good luck."
  else
    [[ $target =~ ^[0-9]+$ ]] || die "reset target must be <n> or 'all'"
    if completed "$target"; then
      sed -i "/^lesson$target$/d" "$PROGRESS_FILE" 2>/dev/null || true
      score_add -100
      info "Lesson $target marked incomplete (100 XP withdrawn)."
    else
      info "Lesson $target was not completed — nothing to reset."
    fi
  fi
}

# ---- dispatch ----
cmd=${1:-status}
shift || true
case $cmd in
  start)            cmd_open 1 ;;
  list)             cmd_list ;;
  open)             cmd_open "${1:-1}" ;;
  brief)            cmd_brief "${1:?usage: ctf brief <n>}" ;;
  next)             cmd_next ;;
  hint)             cmd_hint "$@" ;;
  submit)           cmd_submit "$@" ;;
  status)           cmd_status ;;
  score)            cmd_score ;;
  map)              cmd_map ;;
  reset)            cmd_reset "${1:-all}" ;;
  help|-h|--help)   usage ;;
  *) die "unknown command: $cmd (try: ctf help)" ;;
esac
